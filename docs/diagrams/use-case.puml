
@startuml
title Smart City Waste Management System - Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor Citizen
actor "Collection Vehicle Driver" as Driver
actor "Admin / Municipal Officer" as Admin
actor "Disposal Facility Operator" as Operator
actor "OpenStreetMap / Geocoding" as MapService
actor "SMTP Email Provider" as EmailService

rectangle "Smart City Waste Management System" {
    usecase "Register / Log In" as UC1
    usecase "Submit Waste Collection Request" as UC2
    usecase "Track Request Status" as UC3
    usecase "Cancel Request Before Scheduling" as UC4
    usecase "Receive Status Notifications" as UC5

    usecase "View Assigned Route on Map" as UC6
    usecase "Mark Stop Collected or Missed" as UC7

    usecase "Manage Requests" as UC8
    usecase "Approve / Reject Requests" as UC9
    usecase "Override Request Priority" as UC10
    usecase "Manage Driver and Operator Accounts" as UC11
    usecase "Manage Vehicles" as UC12
    usecase "Assign Driver to Vehicle" as UC13
    usecase "Manage Disposal Facilities" as UC14
    usecase "Generate Collection Routes" as UC15
    usecase "View Operational Dashboard" as UC16
    usecase "Export Daily Collection Report (CSV)" as UC17

    usecase "Record Incoming Waste" as UC18
    usecase "Update Remaining Facility Capacity" as UC19
    usecase "Check Vehicle Load and Capacity" as UC20
    usecase "Find Suitable Facility" as UC21
    usecase "Write Audit Log" as UC22
}

Citizen --> UC1
Citizen --> UC2
Citizen --> UC3
Citizen --> UC4
Citizen --> UC5

Driver --> UC1
Driver --> UC6
Driver --> UC7

Admin --> UC1
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17

Operator --> UC1
Operator --> UC18
Operator --> UC19

MapService --> UC2
MapService --> UC6
EmailService --> UC5

UC18 .> UC19 : <<include>>
UC15 .> UC20 : <<include>>
UC20 .> UC21 : <<include>>
UC9 .> UC22 : <<include>>
UC15 .> UC22 : <<include>>
UC11 .> UC22 : <<include>>

note bottom of UC4
Cancellation is allowed only
before the request is Scheduled.
end note

note bottom of UC20
The vehicle load must never
exceed its capacity.
end note

@enduml
